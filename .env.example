# Gemini AI API Key (Get from: https://makersuite.google.com/app/apikey)
# Optional - the app has a fallback parser if this is not provided
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional alternative, fast/free-tier LLM)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Local Model Name (Optional offline alternative, e.g. llama3, gemma)
# Runs locally on http://localhost:11434 - make sure Ollama service is running!
OLLAMA_MODEL=llama3

# Stellar Keys (Testnet recommended for development)
# Get testnet keys from: https://laboratory.stellar.org/#account-creator
STELLAR_PUBLIC_KEY=GD4VPYDDRNPERKBCKFFJSAOX4UJKNMBG7SCZJ3PV3TS64X5GENQIMCE5
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Soroban Contract ID (for future smart contract features)
SOROBAN_CONTRACT_ID=your_contract_id_here
NEXT_PUBLIC_CONTRACT_ID=your_contract_id_here