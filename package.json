{
  "name": "ai-wallet-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components contexts lib __tests__ middleware.ts --ext .js,.jsx,.ts,.tsx",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "deploy:contracts": "./scripts/deploy-soroban.sh testnet",
    "deploy:testnet": "./scripts/deploy-soroban.sh testnet",
    "deploy:mainnet": "ALLOW_MAINNET_DEPLOY=true ./scripts/deploy-soroban.sh mainnet"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@stellar/freighter-api": "^5.0.0",
    "@stellar/stellar-sdk": "^14.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^15.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.21",
    "jest": "^30.3.0",
    "jest-environment-node": "^30.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.9",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "next": {
      "sharp": "0.35.3"
    }
  }
